{
  "name": "schema-canvas",
  "version": "0.2.0",
  "description": "A framework-neutral database schema canvas for React applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valentindoering/schema-canvas.git"
  },
  "bugs": {
    "url": "https://github.com/valentindoering/schema-canvas/issues"
  },
  "homepage": "https://github.com/valentindoering/schema-canvas#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./server/convex": {
      "types": "./dist/server/convex/index.d.ts",
      "import": "./dist/server/convex/index.js"
    },
    "./server/postgres": {
      "types": "./dist/server/postgres/index.d.ts",
      "import": "./dist/server/postgres/index.js"
    },
    "./server/json-store": {
      "types": "./dist/server/json-store/index.d.ts",
      "import": "./dist/server/json-store/index.js"
    },
    "./server/layout": {
      "types": "./dist/server/layout/index.d.ts",
      "import": "./dist/server/layout/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "schema-canvas": "./dist/cli.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser && pnpm test:example && pnpm build && pnpm example:build && pnpm pack:check && pnpm test:package",
    "example:build": "vite build --config examples/playground/vite.config.ts",
    "example:dev": "vite --config examples/playground/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:example": "playwright test --config playwright.example.config.ts",
    "test:package": "node scripts/test-package.mjs && tsc -p tests/package-fixture/tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elkjs": "^0.11.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12.10.0 <13",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@xyflow/react": "^12.11.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
